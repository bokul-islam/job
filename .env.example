# ---- Core ----
# PostgreSQL connection string (local dev: bundled postgres; production: Supabase)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Public base URL of the app (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret for signing local upload tokens and sandbox webhooks (REQUIRED in production)
UPLOAD_SIGNING_SECRET=change-me-to-a-long-random-string
SANDBOX_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Email (optional) ----
# Resend free tier: 3,000 emails/month, 100/day. Without a key, emails are logged
# to the admin mail outbox instead of being delivered.
RESEND_API_KEY=
EMAIL_FROM=TalentBridge <noreply@yourdomain.com>

# ---- Cloudflare R2 object storage (optional; local disk fallback in dev) ----
# Free tier: 10 GB storage, 10M reads/mo, 1M writes/mo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=talentbridge-files

# ---- Payments (optional; sandbox works without these) ----
# SSLCommerz (https://developer.sslcommerz.com/) sandbox merchant creds
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
# bKash tokenized checkout (https://developer.bka.sh/) sandbox creds
BKASH_APP_KEY=
BKASH_APP_SECRET=

# ---- Inbound email relay (optional; future two-way email reply) ----
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
